    {
      "name": "IoT Legado (Node-RED)",
      "item": [
        {
          "name": "GET /iot (listar todos)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/iot",
              "host": ["{{baseUrl}}"],
              "path": ["iot"]
            },
            "description": "Rota legada — retorna todos os sensores. Equivalente a GET /sensores."
          }
        },
        {
          "name": "POST /newData (criar)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"temperatura\": 22.5,\n  \"pressao\": 1012.0,\n  \"umidade\": 65.0,\n  \"sensor_presenca\": false,\n  \"trava_seguranca\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/newData",
              "host": ["{{baseUrl}}"],
              "path": ["newData"]
            },
            "description": "Rota legada usada pelo Node-RED para criar dados de sensor."
          }
        },
        {
          "name": "PUT /sensor/:id (upsert)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"temperatura\": 35.7,\n  \"pressao\": 1008.5,\n  \"umidade\": 70.2,\n  \"sensor_presenca\": true,\n  \"trava_seguranca\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sensor/1",
              "host": ["{{baseUrl}}"],
              "path": ["sensor", "1"]
            },
            "description": "Rota legada usada pelo Node-RED a cada 5s para atualizar sensor."
          }
        }
      ]
    }
